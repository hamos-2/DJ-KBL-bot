# Application
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL Container Credentials
POSTGRES_DB=kbl_bot
POSTGRES_USER=kbl_user
POSTGRES_PASSWORD=kbl_pass

# Database (inside Docker network uses host 'postgres')
DATABASE_URL=postgresql+asyncpg://kbl_user:kbl_pass@postgres:5432/kbl_bot

# Redis (inside Docker network uses host 'redis')
REDIS_URL=redis://redis:6379/0

# Security — REQUIRED: generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
MASTER_ENCRYPTION_KEY=
HMAC_SECRET_KEY=

# Worker
WORKER_LIVE_INTERVAL_SECONDS=5
WORKER_SCHEDULED_INTERVAL_SECONDS=60
WORKER_LOOKAHEAD_DAYS=60

# Provider ("daum" or "mock")
PROVIDER_MODE=daum

# Kakao Skill Secret (optional header X-Kakao-Skill-Secret)
KAKAO_SKILL_SECRET=

# Cloudflare Zero Trust Tunnel Token (for --profile prod)
CLOUDFLARE_TUNNEL_TOKEN=

# SRE Watchdog Incident Email Alerting (SMTP)
ALERT_EMAIL_TO=mjubookfestival@gmail.com
ALERT_EMAIL_FROM="KBL SRE Watchdog <alert@kbl-bot.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

